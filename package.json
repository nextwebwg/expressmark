{
  "name": "expressmark",
  "version": "0.1.1",
  "description": "Parse and write Expressive Markdown with its document AST.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "test": "pnpm build && vitest run",
    "test:package": "pnpm build && vitest run tests/package.test.ts",
    "verify:inner": "pnpm lint && pnpm typecheck",
    "verify:pr": "pnpm verify:inner && pnpm test",
    "verify:release": "pnpm verify:pr",
    "check:freshness": "npm outdated --json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/sanitize-html": "2.16.2",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://nextwebwg.org/expressive-markdown/",
  "bugs": {
    "url": "https://github.com/nextwebwg/expressmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextwebwg/expressmark.git"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "htmlparser2": "12.0.0",
    "markdown-it": "15.0.3",
    "parseman": "0.54.0",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  }
}
